# Copie este arquivo para .env.local e preencha. Nada aqui vai para o git.

# ---------- Google Sheets (obrigatório) ----------
# Do JSON da conta de serviço: client_email e private_key.
# A private_key vai entre aspas, com os \n literais como estão no JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---------- Sessão (obrigatório) ----------
# Qualquer string longa e aleatória. Ex.: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Administração da agência (obrigatório para usar /admin) ----------
ADMIN_SENHA=

# ---------- Fuso ----------
TZ=America/Sao_Paulo

# ---------- Banco de leads (obrigatório para o rastreamento do WhatsApp) ----------
# Postgres (Neon, Supabase, Railway ou local). É o que guarda cada mensagem,
# cada evento de atribuição e a trava que impede o mesmo evento do Meta de
# virar dois leads. SEM ELE o webhook do WhatsApp ainda grava na planilha, mas
# sem histórico de mensagens e sem garantia contra duplicidade.
# Depois de preencher, rode: npm run migrar
DATABASE_URL=

# Chave para cifrar tokens da Meta guardados no banco (AES-256-GCM).
# Gere com: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Hoje nada é gravado cifrado (o token de ads vem do ambiente); passa a fazer
# falta quando o Embedded Signup entrar.
ENCRYPTION_KEY=

# Segredo do job que completa a atribuição pendente (/api/jobs/atribuicao).
# Sem ele o job responde 503 — é o que impede qualquer um de disparar consultas
# na Graph API e escritas na planilha do cliente.
# Gere com: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
CRON_SECRET=

# ---------- Webhooks da Meta (só se for receber lead direto da Meta) ----------
# App Secret do app do Meta. Valida a assinatura dos POSTs em /api/meta e
# /api/whatsapp. SEM ELE, EM PRODUÇÃO OS DOIS WEBHOOKS SÃO RECUSADOS (503) —
# é o que impede qualquer um de gravar leads falsos na planilha do cliente.
META_APP_SECRET=

# Token de verificação do webhook de leadgen (/api/meta). Você inventa o valor
# e repete o mesmo no painel do app do Meta.
META_VERIFY_TOKEN=

# Token de verificação do webhook do WhatsApp (/api/whatsapp). Idem, e pode ser
# diferente do de cima.
META_WHATSAPP_VERIFY_TOKEN=

# ---------- Conta de anúncios (investimento, CPL, ROAS) ----------
# Token de usuário de sistema COM ads_read, com acesso às contas de anúncio de
# todos os clientes. É o arranjo normal de agência: preenche aqui uma vez, e no
# cadastro de cada cliente você só escolhe a conta na lista.
# O token de conversões (conversoes.meta.accessToken) NÃO serve: ele não tem
# ads_read. Um cliente pode ter token próprio em metaAds.accessToken.
META_ADS_TOKEN=

# ---------- Clientes em produção ----------
# Em dev os clientes ficam no tenants.json. Em produção (disco efêmero), cole
# aqui o JSON do cadastro — botão "Exportar (TENANTS)" na tela /admin.
# Com TENANTS definido, o cadastro fica somente-leitura.
# TENANTS=[{"slug":"acme", ...}]
